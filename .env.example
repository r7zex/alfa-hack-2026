# Copy this file to .env before starting Compose or local FastAPI.
# Synthetic development credentials only. Set a strong password before deploying.
# DB_PORT is the host-side port for local PyCharm; Docker app uses db:5432.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=alfa_hack
DB_USER=alfa_demo
DB_PASSWORD=replace_this_before_vps
APP_PORT=8000

# Seven-day server sessions. Enable Secure cookies when the site uses HTTPS.
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
# Explicitly allows passwordless synthetic client/admin accounts for a local demo.
# Keep disabled on any shared deployment with real data.
DEMO_AUTH_ENABLED=false
AUTH_REQUESTS_PER_MINUTE=30
AUTH_EMAIL_REQUESTS_PER_MINUTE=10

# Optional OpenAI-compatible Qwen service; no model is pulled at startup.
ASSISTANT_ENABLED=false
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen2.5:1.5b
QWEN_API_KEY=
QWEN_REQUIRE_API_KEY=false
QWEN_REASONING_EFFORT=auto
ASSISTANT_TIMEOUT_SECONDS=60

# Durable PostgreSQL processing. Delay is optional and defaults to zero.
PIPELINE_ASYNC_ENABLED=true
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=1
PIPELINE_STEP_DELAY_SECONDS=0
INTEGRATION_TIMEOUT_SECONDS=2

# Conditional in-product demo signature, never SMS or a qualified signature.
SIGNING_REQUIRE_CODE=true
DEMO_SIGNING_CODE_VISIBLE=false
SIGNING_CODE_TTL_SECONDS=180
SIGNING_CODE_MAX_ATTEMPTS=5
# Empty uses the DB secret as HMAC key; set a separate secret in shared installs.
SIGNING_CODE_SECRET=
